{
  "app": {
    "bundleName": "com.hwt.echomusic",
    "vendor": "echomusic",
    // versionCode 与关于页 / CHANGELOG 里的构建号 1300232 对齐。注意：1300232 小于
    // 上一版的 3000001，属于降级安装，覆盖安装需 `bm install -d`（debug 签名）或卸载重装。
    "versionCode": 1300232,
    // versionName 必须是纯语义化版本（应用市场会自行追加 "(versionCode)" 展示/校验），
    // 不要写成 "1.3.0(1300232)"：否则包信息显示成 "1.3.0(1300232) (1300232)"，
    // 上传应用市场会因版本名格式不合规报错。界面上的完整版本号由
    // AboutSettingsSection.vue 的 versionLabel 硬编码展示，CHANGELOG 标题保留带构建号写法。
    "versionName": "1.3.0",
    "icon": "$media:app_icon",
    "label": "$string:app_name",
    "configuration": "$profile:configuration"
  }
}
